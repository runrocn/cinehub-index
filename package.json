{
  "name": "cinehub",
  "version": "0.1.0",
  "description": "CineHub - 多源在线观影客户端（苹果CMS V10 协议）",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dev:all": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dist": "npm run build && electron-builder --win",
    "crawl": "node scripts/crawl.mjs"
  },
  "dependencies": {
    "dplayer": "^1.27.1",
    "hls.js": "^1.5.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.cinehub.app",
    "productName": "CineHub",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CineHub"
    }
  }
}
